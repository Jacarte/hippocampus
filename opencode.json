{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "bash": "allow"
  },
  "mcp": {
    "postgres": {
      "type": "local",
      "command": [
        "pnpx",
        "@modelcontextprotocol/server-postgres",
        "postgresql://postgres:postgres@192.168.0.160:15442/postgres"
      ]
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}"
      }
    }
  }
}
