          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "rate(retrieval_degradations_total[$__rate_interval])",
          "legendFormat": "{{stage}} — {{reason}}",
          "refId": "A"
        }
      ],
      "description": "Times per second a stage was unavailable, by stage and reason. Above zero means answers came from a reduced pipeline."
    },
    {
