server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Proxy API and backend routes to the mem0 server
    # Regex: only match exact path or path with trailing slash, so /index.html is NOT proxied
    location ~ ^/(admin|health|index|memories|search|retrieve|query)(/|$) {
        proxy_pass ${MEM0_SERVER_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA fallback — serve index.html for any unmatched route
    location / {
        try_files $uri $uri/ /index.html;
    }
}
